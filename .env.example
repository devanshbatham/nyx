NYX_MODEL_PATH=/opt/nyx-model
NYX_BACKEND=llamacpp
NYX_LLAMACPP_URL=http://127.0.0.1:30000
NYX_LLAMACPP_CONCURRENCY=1
NYX_API_KEY_FILE=/etc/nyx/api-key
NYX_HOST=127.0.0.1
NYX_PORT=8000
NYX_HOSTED_MAX_PROMPT_TOKENS=4095
NYX_HOSTED_MAX_INFLIGHT=1
NYX_HOSTED_MAX_WAITING=32
NYX_HOSTED_QUEUE_SIZE=32
NYX_HOSTED_WORKERS=4
NYX_HOSTED_REQUESTS_PER_MINUTE=120
NYX_CONTEXT_ACCOUNTING=independent
NYX_MAX_QUESTIONS=0
